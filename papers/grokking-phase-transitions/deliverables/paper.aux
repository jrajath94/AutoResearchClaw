\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Critical fraction $f_c$ as a function of width. The threshold decreases monotonically with width, from $f_c = 0.7$ at $w = 32$ to $f_c = 0.4$ at $w = 128$, indicating that wider models require less data to cross the phase boundary.}}{18}{figure.caption.20}\protected@file@percent }
\newlabel{fig:scaling_curves}{{3}{18}{Critical fraction $f_c$ as a function of width. The threshold decreases monotonically with width, from $f_c = 0.7$ at $w = 32$ to $f_c = 0.4$ at $w = 128$, indicating that wider models require less data to cross the phase boundary}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distribution of test accuracy across seeds and conditions. Each violin shows the distribution over 3 seeds. The bimodal structure at intermediate dataset fractions (near $f_c$) is consistent with a phase transition: some seeds have crossed the threshold while others remain in the memorization state.}}{19}{figure.caption.34}\protected@file@percent }
\newlabel{fig:metric_dist}{{4}{19}{Distribution of test accuracy across seeds and conditions. Each violin shows the distribution over 3 seeds. The bimodal structure at intermediate dataset fractions (near $f_c$) is consistent with a phase transition: some seeds have crossed the threshold while others remain in the memorization state}{figure.caption.34}{}}
