\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Training and test accuracy curves for representative conditions. Grokking manifests as a gap between early memorization (train accuracy $\to 1$) and delayed generalization (test accuracy $\to 1$), which closes as dataset fraction exceeds $f_c$.}}{15}{figure.caption.29}\protected@file@percent }
\newlabel{fig:grokking_curves}{{4}{15}{Training and test accuracy curves for representative conditions. Grokking manifests as a gap between early memorization (train accuracy $\to 1$) and delayed generalization (test accuracy $\to 1$), which closes as dataset fraction exceeds $f_c$}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Superposition index $\mathcal  {S}(\Phi )$ dynamics during training. Conditions that grok show a sharp drop in $\mathcal  {S}$ coincident with the rise in test accuracy, consistent with the predicted superposition$\to $clean-feature transition. Non-grokking conditions remain at high $\mathcal  {S}$ throughout training.}}{15}{figure.caption.30}\protected@file@percent }
\newlabel{fig:superposition_dynamics}{{5}{15}{Superposition index $\supidx (\Phi )$ dynamics during training. Conditions that grok show a sharp drop in $\supidx $ coincident with the rise in test accuracy, consistent with the predicted superposition$\to $clean-feature transition. Non-grokking conditions remain at high $\supidx $ throughout training}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Final test loss as a function of training fraction across widths. Wider models exhibit a pronounced knee at smaller $f$, aligning with the $n_c$ values in Table~\ref {tab:nc_observed} and supporting the unification of the grokking threshold and the scaling-law knee.}}{16}{figure.caption.31}\protected@file@percent }
\newlabel{fig:scaling_law}{{6}{16}{Final test loss as a function of training fraction across widths. Wider models exhibit a pronounced knee at smaller $f$, aligning with the $\nc $ values in Table~\ref {tab:nc_observed} and supporting the unification of the grokking threshold and the scaling-law knee}{figure.caption.31}{}}
